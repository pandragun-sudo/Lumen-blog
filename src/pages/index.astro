---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => post.data.pubDate.valueOf() <= Date.now())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryNames: Record<string, string> = {
	devlog: '제작 기록',
	'case-study': '채널 분석',
	guide: '가이드',
	trend: '트렌드',
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* Hero Section */
			.hero {
				padding: 3.5rem 1rem 2rem;
				text-align: center;
				margin-bottom: 2rem;
				background: transparent;
				border: none;
				box-shadow: none;
			}
			.hero h1 {
				font-size: 3rem;
				font-weight: 800;
				margin-bottom: 1rem;
				background: linear-gradient(90deg, #1e293b 0%, #3b82f6 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				letter-spacing: -0.03em;
			}
			.hero p {
				font-size: 1.2rem;
				color: var(--text-muted);
				max-width: 600px;
				margin: 0 auto;
				line-height: 1.6;
			}
			

			.start-here {
				max-width: 760px;
				margin: 0 auto 2.5rem;
				padding: 1.5rem 1.75rem;
				border: 1px solid var(--border-light);
				border-radius: 16px;
				background: var(--bg);
			}
			.start-here h2 {
				font-size: 1.2rem;
				margin: 0 0 0.6rem;
			}
			.start-here p {
				margin: 0 0 0.8rem;
				line-height: 1.7;
				color: var(--text-muted);
			}
			.start-here ul {
				margin: 0 0 0.8rem;
				padding-left: 1.2rem;
				line-height: 1.9;
			}
			.start-here .start-note {
				margin: 0;
				font-size: 0.95rem;
			}

			main {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 1em 4em;
			}
			.blog-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2.5rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.blog-grid li {
				display: flex;
				flex-direction: column;
				transition: transform 0.3s ease, box-shadow 0.3s ease;
				background: var(--bg);
				border-radius: 16px;
				overflow: hidden;
				border: 1px solid var(--border-light);
			}
			.blog-grid li:hover {
				transform: translateY(-5px);
				box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
			}
			
			/* Hero Article (First Post) */
			.blog-grid li:first-child {
				grid-column: 1 / -1; /* Spans all 3 columns */
				margin-bottom: 2rem;
				border: none;
				background: linear-gradient(180deg, var(--bg) 0%, var(--bg-light) 100%);
				border-radius: 24px;
				overflow: hidden;
				box-shadow: 0 4px 20px rgba(0,0,0,0.04);
			}
			.blog-grid li:first-child:hover {
				transform: translateY(-5px);
				box-shadow: 0 16px 32px rgba(0,0,0,0.1);
			}
			.blog-grid li:first-child img {
				width: 100%;
				height: auto;
				aspect-ratio: 16 / 9;
				object-fit: cover;
				border-radius: 16px;
			}
			.blog-grid li:first-child .post-content {
				padding: 2.5rem 2rem;
			}
			.blog-grid li:first-child .title {
				font-size: 2rem;
				margin-bottom: 1rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				display: block;
				-webkit-line-clamp: unset;
			}
			.blog-grid li:first-child .description {
				font-size: 1.15rem;
				line-height: 1.7;
				margin-bottom: 1.5rem;
				display: block;
				-webkit-line-clamp: unset;
			}
			
			/* Regular Articles */
			.blog-grid li:not(:first-child) img {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
				border-bottom: 1px solid var(--border-light);
			}
			.blog-grid li:not(:first-child) .post-content {
				padding: 1.5rem;
			}
			/* Category Badges */
			.category-badge {
				display: inline-block;
				padding: 0.25rem 0.65rem;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.02em;
				border-radius: 9999px;
				margin-bottom: 0.6rem;
				width: fit-content;
			}
			.category-badge.devlog {
				background: rgba(59, 130, 246, 0.1);
				color: #2563eb;
				border: 1px solid rgba(59, 130, 246, 0.2);
			}
			.category-badge.case-study {
				background: rgba(16, 185, 129, 0.1);
				color: #059669;
				border: 1px solid rgba(16, 185, 129, 0.2);
			}
			.category-badge.guide {
				background: rgba(245, 158, 11, 0.1);
				color: #d97706;
				border: 1px solid rgba(245, 158, 11, 0.2);
			}
			.category-badge.trend {
				background: rgba(139, 92, 246, 0.1);
				color: #7c3aed;
				border: 1px solid rgba(139, 92, 246, 0.2);
			}

			.title {
				margin: 0 0 0.5rem 0;
				color: var(--text-main);
				font-size: 1.35rem;
				line-height: 1.4;
				font-weight: 700;
				word-break: keep-all;
				transition: color 0.2s;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.description {
				color: var(--text-muted);
				font-size: 0.95rem;
				line-height: 1.6;
				margin-top: 0.5rem;
				word-break: keep-all;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.date {
				margin: 1rem 0 0;
				color: var(--text-light);
				font-size: 0.85rem;
				font-weight: 500;
			}
			
			/* Links */
			.blog-grid li a {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
				color: inherit;
			}
			.blog-grid li:first-child a {
				display: grid;
				grid-template-columns: 1fr 1.15fr;
				gap: 2rem;
				align-items: center;
				padding: 1.5rem;
			}
			
			@media (max-width: 900px) {
				.blog-grid {
					grid-template-columns: repeat(2, 1fr);
					gap: 1.5rem;
				}
				.blog-grid li:first-child {
					grid-template-columns: 1fr;
				}
				.blog-grid li:first-child a {
					flex-direction: column;
				}
				.blog-grid li:first-child .post-content {
					padding: 2rem;
				}
				.blog-grid li:first-child .title {
					font-size: 1.7rem;
				}
			}
			@media (max-width: 600px) {
				.hero {
					padding: 3rem 1rem 2rem;
				}
				.hero h1 {
					font-size: 2.2rem;
				}
				.blog-grid {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
				.blog-grid li:first-child .post-content {
					padding: 1.5rem;
				}
				.blog-grid li:first-child .title {
					font-size: 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		
		<section class="hero">
			<h1>Lumen Insights Lab</h1>
			<p>쇼츠 채널을 직접 운영하며 스튜디오 지표를 읽고, 그 해석을 기록합니다</p>
		</section>

		<section class="start-here">
			<h2>처음 읽는 분께</h2>
			<p>이 블로그는 한 명의 운영자가 쇼츠 채널에서 직접 확인한 지표와 그 해석을 다룹니다.<br />일부 글은 같은 내용을 설명 영상으로도 만들어 <a href="https://youtube.com/@lumeninsightslab" target="_blank" rel="noopener noreferrer">블로그 유튜브 채널</a>에 올립니다.</p>
			<ul>
				<li><a href="/blog/2026-10-06-shorts-growth-137-videos-length-retention-frequency/">쇼츠 137편 데이터로 본 길이, 평균 조회율, 업로드 빈도</a></li>
				<li><a href="/blog/2026-09-11-shorts-retention-vs-watch-time-share-algorithm/">피드 잔존율 55%로 250만 뷰를 넘긴 사례</a></li>
				<li><a href="/blog/2026-10-03-how-youtube-algorithm-measures-story-retention/">유튜브가 이야기의 재미를 수치로 읽는 방식</a></li>
			</ul>
			<p class="start-note">분류별로 보려면 <a href="/blog/">전체 글 목록</a>에서 채널 분석, 가이드, 트렌드, 제작 기록을 골라 볼 수 있습니다.</p>
		</section>

		<main>
			<ul class="blog-grid">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && post.data.heroImage !== 'AI_GENERATED' && (
									typeof post.data.heroImage === 'string' && post.data.heroImage.startsWith('http')
										? <img width={800} height={450} src={post.data.heroImage} alt="" style="width:100%;aspect-ratio:16/9;object-fit:cover;" />
										: <Image width={800} height={450} src={post.data.heroImage} alt="" />
								)}
								<div class="post-content">
									<span class={`category-badge ${post.data.category || 'devlog'}`}>
										{categoryNames[post.data.category] || '제작 기록'}
									</span>
									<h4 class="title">{post.data.title}</h4>
									<p class="description">{post.data.description}</p>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
