---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => post.data.pubDate.valueOf() <= Date.now())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryNames: Record<string, string> = {
	devlog: '개발일지',
	'case-study': '채널 분석',
	guide: '가이드',
	trend: '트렌드',
};
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			/* Hero Section */
			.hero {
				padding: 5rem 1rem 4rem;
				text-align: center;
				background: linear-gradient(135deg, #0e0b14 0%, #1a1326 50%, #0e0b14 100%);
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				margin-bottom: 3.5rem;
				position: relative;
				overflow: hidden;
			}
			.hero::before {
				content: '';
				position: absolute;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%);
				width: 550px;
				height: 220px;
				background: radial-gradient(ellipse at center, rgba(168, 85, 247, 0.16) 0%, transparent 70%);
				pointer-events: none;
			}
			.hero h1 {
				font-size: 3.2rem;
				font-weight: 800;
				margin-bottom: 1rem;
				background: linear-gradient(135deg, #ffffff 0%, #e9d5ff 50%, #c084fc 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				letter-spacing: -0.03em;
				position: relative;
			}
			.hero p {
				font-size: 1.15rem;
				color: #cbd5e1;
				max-width: 620px;
				margin: 0 auto;
				line-height: 1.7;
				position: relative;
			}
			
			main {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 1em 4em;
			}
			.blog-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2.5rem;
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.blog-grid li {
				display: flex;
				flex-direction: column;
				transition: transform 0.3s ease, box-shadow 0.3s ease;
				background: var(--bg);
				border-radius: 16px;
				overflow: hidden;
				border: 1px solid var(--border-light);
			}
			.blog-grid li:hover {
				transform: translateY(-5px);
				box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
			}
			
			/* Hero Article (First Post) */
			.blog-grid li:first-child {
				grid-column: 1 / -1; /* Spans all 3 columns */
				margin-bottom: 2rem;
				border: none;
				background: linear-gradient(180deg, var(--bg) 0%, var(--bg-light) 100%);
				border-radius: 24px;
				overflow: hidden;
				box-shadow: 0 4px 20px rgba(0,0,0,0.04);
			}
			.blog-grid li:first-child:hover {
				transform: translateY(-5px);
				box-shadow: 0 16px 32px rgba(0,0,0,0.1);
			}
			.blog-grid li:first-child img {
				width: 100%;
				height: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
			}
			.blog-grid li:first-child .post-content {
				padding: 3rem;
			}
			.blog-grid li:first-child .title {
				font-size: 2rem;
				margin-bottom: 1rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				display: block;
				-webkit-line-clamp: unset;
			}
			.blog-grid li:first-child .description {
				font-size: 1.15rem;
				line-height: 1.7;
				margin-bottom: 1.5rem;
				display: block;
				-webkit-line-clamp: unset;
			}
			
			/* Regular Articles */
			.blog-grid li:not(:first-child) img {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
				border-bottom: 1px solid var(--border-light);
			}
			.blog-grid li:not(:first-child) .post-content {
				padding: 1.5rem;
			}
			/* Category Badges */
			.category-badge {
				display: inline-block;
				padding: 0.25rem 0.65rem;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.02em;
				border-radius: 9999px;
				margin-bottom: 0.6rem;
				width: fit-content;
			}
			.category-badge.devlog {
				background: rgba(59, 130, 246, 0.1);
				color: #2563eb;
				border: 1px solid rgba(59, 130, 246, 0.2);
			}
			.category-badge.case-study {
				background: rgba(16, 185, 129, 0.1);
				color: #059669;
				border: 1px solid rgba(16, 185, 129, 0.2);
			}
			.category-badge.guide {
				background: rgba(245, 158, 11, 0.1);
				color: #d97706;
				border: 1px solid rgba(245, 158, 11, 0.2);
			}
			.category-badge.trend {
				background: rgba(139, 92, 246, 0.1);
				color: #7c3aed;
				border: 1px solid rgba(139, 92, 246, 0.2);
			}

			.title {
				margin: 0 0 0.5rem 0;
				color: var(--text-main);
				font-size: 1.35rem;
				line-height: 1.4;
				font-weight: 700;
				word-break: keep-all;
				transition: color 0.2s;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.description {
				color: var(--text-muted);
				font-size: 0.95rem;
				line-height: 1.6;
				margin-top: 0.5rem;
				word-break: keep-all;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.date {
				margin: 1rem 0 0;
				color: var(--text-light);
				font-size: 0.85rem;
				font-weight: 500;
			}
			
			/* Links */
			.blog-grid li a {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
				color: inherit;
			}
			.blog-grid li:first-child a {
				display: grid;
				grid-template-columns: 1.2fr 1fr;
				align-items: center;
			}
			
			@media (max-width: 900px) {
				.blog-grid {
					grid-template-columns: repeat(2, 1fr);
					gap: 1.5rem;
				}
				.blog-grid li:first-child {
					grid-template-columns: 1fr;
				}
				.blog-grid li:first-child a {
					flex-direction: column;
				}
				.blog-grid li:first-child .post-content {
					padding: 2rem;
				}
				.blog-grid li:first-child .title {
					font-size: 1.7rem;
				}
			}
			@media (max-width: 600px) {
				.hero {
					padding: 3rem 1rem 2rem;
				}
				.hero h1 {
					font-size: 2.2rem;
				}
				.blog-grid {
					grid-template-columns: 1fr;
					gap: 1.5rem;
				}
				.blog-grid li:first-child .post-content {
					padding: 1.5rem;
				}
				.blog-grid li:first-child .title {
					font-size: 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		
		<section class="hero">
			<h1>Lumen Insights Lab</h1>
			<p>데이터가 증명하는 유튜브 쇼츠 알고리즘 분석과 1인 엔지니어링 실전 기록</p>
		</section>

		<main>
			<ul class="blog-grid">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								{post.data.heroImage && post.data.heroImage !== 'AI_GENERATED' && (
									typeof post.data.heroImage === 'string' && post.data.heroImage.startsWith('http')
										? <img width={800} height={450} src={post.data.heroImage} alt="" style="width:100%;aspect-ratio:16/9;object-fit:cover;" />
										: <Image width={800} height={450} src={post.data.heroImage} alt="" />
								)}
								<div class="post-content">
									<span class={`category-badge ${post.data.category || 'devlog'}`}>
										{categoryNames[post.data.category] || '개발일지'}
									</span>
									<h4 class="title">{post.data.title}</h4>
									<p class="description">{post.data.description}</p>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>
