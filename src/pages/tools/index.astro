---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`무료 툴 모음 | ${SITE_TITLE}`} description="유튜브 쇼츠 크리에이터를 위한 루멘 인사이트 무료 웹 툴 모음" />
		<style>
			main {
				width: 960px;
			}
			h1 {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.tools-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2rem;
				margin-top: 2rem;
			}
			.tool-card {
				background: var(--bg);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 2rem;
				text-decoration: none;
				color: var(--text-main);
				transition: all 0.2s ease;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}
			.tool-card:hover {
				transform: translateY(-5px);
				box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
				border-color: #3b82f6;
			}
			.tool-icon {
				font-size: 2.5rem;
			}
			.tool-title {
				font-size: 1.25rem;
				font-weight: 700;
				margin: 0;
			}
			.tool-desc {
				font-size: 0.95rem;
				color: var(--text-muted);
				line-height: 1.5;
				margin: 0;
				flex-grow: 1;
			}
			.tool-action {
				font-size: 0.9rem;
				font-weight: 600;
				color: #3b82f6;
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #f59e0b;"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg> 유튜브 크리에이터 무료 툴</h1>
			<p style="color: var(--text-muted); margin-bottom: 2rem;">
				유튜브 쇼츠 채널 성장에 필요한 필수 계산기와 분석 도구를 무료로 제공합니다.
			</p>
			
			<div class="tools-grid">
				<!-- Tool 1: Revenue Calculator -->
				<a href="/tools/revenue-calculator" class="tool-card">
					<div class="tool-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #eab308;"><circle cx="12" cy="12" r="10"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 18V6"/></svg></div>
					<h3 class="tool-title">쇼츠 예상 수익 계산기</h3>
					<p class="tool-desc">
						국가별, 주제별 평균 RPM을 기반으로 내 쇼츠 채널의 예상 월수익과 연수익을 정확하게 계산해 보세요.
					</p>
					<div class="tool-action">계산기 사용하기 &rarr;</div>
				</a>

				<!-- Tool 2: Title Analyzer -->
				<a href="/tools/title-analyzer" class="tool-card">
					<div class="tool-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #3b82f6;"><path d="m18 5-2.414-2.414A2 2 0 0 0 14.172 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2"/><path d="M21.378 12.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/><path d="M8 18h1"/></svg></div>
					<h3 class="tool-title">유튜브 제목 최적화 분석기</h3>
					<p class="tool-desc">
						모바일 화면에서 제목이 잘리지 않는지 체크하고, 클릭률(CTR)을 높이는 최적의 글자 수인지 분석합니다.
					</p>
					<div class="tool-action">제목 분석하기 &rarr;</div>
				</a>

				<!-- Tool 3: Shadowban Checker -->
				<a href="/tools/shadowban-checker" class="tool-card">
					<div class="tool-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #ef4444;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg></div>
					<h3 class="tool-title">쇼츠 노출락(섀도우밴) 진단기</h3>
					<p class="tool-desc">
						최근 영상 조회수를 입력하여 알고리즘 노출 정지 상태인지, 혹은 정상적으로 적응 중인지 진단해 보세요.
					</p>
					<div class="tool-action">노출락 자가진단 &rarr;</div>
				</a>

				<!-- Tool 4: Title Generator -->
				<a href="/tools/title-generator" class="tool-card">
					<div class="tool-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #8b5cf6;"><path d="M2 12h4l3-9 5 18 3-9h5"/></svg></div>
					<h3 class="tool-title">상위 1% 3초 바이럴 훅 제조기</h3>
					<p class="tool-desc">
						다루고 싶은 핵심 키워드를 입력하면, 대중의 클릭을 미친 듯이 유도하는 10개의 어그로성 제목을 즉시 생성합니다.
					</p>
					<div class="tool-action">바이럴 제목 만들기 &rarr;</div>
				</a>

				<!-- Tool 5: Safe Zone Preview -->
				<a href="/tools/safe-zone-preview" class="tool-card">
					<div class="tool-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #10b981;"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg></div>
					<h3 class="tool-title">쇼츠 화면 가림막(Safe Zone) 검사기</h3>
					<p class="tool-desc">
						내 영상을 업로드하기 전, 유튜브 쇼츠 UI(좋아요 버튼, 자막 위치 등)에 중요한 장면이 가려지지 않는지 확인하세요.
					</p>
					<div class="tool-action">화면 비율 검사하기 &rarr;</div>
				</a>

				<!-- Tool 6: Golden Time Calculator -->
				<a href="/tools/golden-time-calculator" class="tool-card">
					<div class="tool-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #f97316;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
					<h3 class="tool-title">쇼츠 황금시간대 계산기</h3>
					<p class="tool-desc">
						내 채널의 타겟 연령대와 콘텐츠 장르를 입력하여 급상승 확률이 가장 높은 최적의 영상 업로드 시간을 확인하세요.
					</p>
					<div class="tool-action">업로드 시간 확인하기 &rarr;</div>
				</a>

				<!-- Tool 7: Subtitle Converter -->
				<a href="/tools/subtitle-converter" class="tool-card">
					<div class="tool-icon"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #ec4899;"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg></div>
					<h3 class="tool-title">자막 파일 형식 변환기</h3>
					<p class="tool-desc">
						SMI, SRT, VTT 포맷의 자막 파일을 서로 변환할 수 있습니다. 개인정보 보호를 위해 브라우저에서 안전하게 처리됩니다.
					</p>
					<div class="tool-action">자막 변환하기 &rarr;</div>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
