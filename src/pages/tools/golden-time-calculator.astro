---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`쇼츠 황금시간대 계산기 | ${SITE_TITLE}`} description="내 유튜브 채널의 타겟 시청자 연령대와 콘텐츠 주제를 기반으로 조회수가 폭발하는 최적의 업로드 시간을 계산합니다." />
		<style>
			main { width: 800px; max-width: calc(100% - 2em); margin: 0 auto; }
			h1 { display: flex; align-items: center; gap: 0.5rem; }
			.tool-container { background: var(--bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 2rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); margin-bottom: 3rem; }
			.input-group { margin-bottom: 1.5rem; }
			.input-group label { display: block; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-main); }
			.input-group select { width: 100%; padding: 1rem; border: 1px solid var(--border-color); border-radius: 6px; background: var(--bg-alt); color: var(--text-main); font-size: 1.1rem; appearance: none; cursor: pointer; }
			.btn-primary { width: 100%; padding: 1rem; background: #f97316; color: #fff; font-weight: bold; border: none; border-radius: 6px; cursor: pointer; font-size: 1.1rem; transition: background 0.2s; }
			.btn-primary:hover { background: #ea580c; }
			
			.result-box { display: none; margin-top: 2rem; background: rgba(249, 115, 22, 0.1); border: 1px solid rgba(249, 115, 22, 0.2); border-radius: 8px; padding: 2rem; text-align: center; }
			.result-title { font-size: 1.2rem; color: var(--text-muted); margin-bottom: 0.5rem; }
			.result-time { font-size: 2rem; font-weight: 800; color: #f97316; margin: 0.5rem 0; }
			.result-desc { font-size: 1rem; color: var(--text-main); line-height: 1.6; margin-top: 1rem; }
			
			.seo-content { line-height: 1.8; color: var(--text-main); }
			.seo-content h2 { margin-top: 2.5rem; margin-bottom: 1rem; }
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #f97316;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 쇼츠 황금시간대 계산기</h1>
			<p style="color: var(--text-muted); margin-bottom: 2rem;">콘텐츠를 주로 소비하는 메인 타겟 연령대와 채널의 장르를 선택하여 가장 트래픽이 몰리는 업로드 타이밍을 확인하세요.</p>
			
			<div class="tool-container">
				<div class="input-group">
					<label for="target-age">메인 타겟 시청자 연령대</label>
					<select id="target-age">
						<option value="1020">10대 ~ 20대 초반 (학생/대학생)</option>
						<option value="2030">20대 중반 ~ 30대 (직장인)</option>
						<option value="4050">40대 ~ 50대 이상 (주부/중장년층)</option>
					</select>
				</div>
				<div class="input-group">
					<label for="category">콘텐츠 카테고리 (유튜브 공식)</label>
					<select id="category">
						<option value="entertainment">엔터테인먼트 / 코미디 / 영화</option>
						<option value="gaming">게임 (Gaming)</option>
						<option value="music">음악 / 댄스 (Music)</option>
						<option value="education">교육 / 과학기술 (지식, 테크)</option>
						<option value="howto">노하우 / 스타일 (요리, 뷰티, DIY)</option>
						<option value="news">뉴스 / 정치 / 경제</option>
						<option value="people">인물 / 블로그 (Vlog, 일상)</option>
						<option value="sports">스포츠 / 건강</option>
						<option value="pets">반려동물 / 동물</option>
						<option value="travel">여행 / 이벤트</option>
						<option value="autos">자동차 / 교통</option>
					</select>
				</div>
				
				<button class="btn-primary" id="calc-btn">최적 업로드 시간 확인</button>

				<div id="result-box" class="result-box">
					<div class="result-title">예상 황금 업로드 시간대</div>
					<div id="result-time" class="result-time"></div>
					<div id="result-desc" class="result-desc"></div>
				</div>
			</div>

			<div class="seo-content">
				<h2>황금시간대, 알고리즘을 깨우는 첫 번째 열쇠</h2>
				<p>
					"유튜브 쇼츠는 몇 시에 올려야 가장 많이 조회되는가"는 수많은 크리에이터들이 매일같이 던지는 질문입니다.  
					결론부터 말씀드리자면, 모두에게 통용되는 단 하나의 완벽한 업로드 시간은 존재하지 않습니다.  
					하지만 내 채널을 구독하고 내 콘텐츠를 기다리는 <span style="color: #2563eb;">코어 시청자들의 라이프스타일</span>을 정확히 저격하는 황금시간대는 반드시 존재합니다.  
					영상이 업로드된 직후 초기 1시간 동안의 '참여도(Engagement)'가 전체 1,000만 뷰를 결정짓는 유튜브 쇼츠 생태계에서, 업로드 타이밍을 맞추는 것은 알고리즘에 강력한 첫 번째 부스터를 다는 것과 같습니다.  
				</p>

				<h2>남들이 다 올리는 시간에 나도 올리면 벌어지는 일</h2>
				<p>
					가장 흔히 범하는 치명적인 실수는 인터넷에 떠도는 '일반적인 황금시간대(평일 저녁 6시~8시)'에 무작정 영상을 업로드하는 것입니다.  
					이 시간대는 유튜브 전체의 트래픽이 가장 높은 시간이 맞습니다. 하지만 동시에 대형 크리에이터들을 포함한 모든 유튜버가 가장 많은 영상을 쏟아내는 <span style="color: #ef4444;">초경쟁 시간대(Red Ocean)</span>이기도 합니다.  
					이제 막 시작한 초보 유튜버의 영상이 이 시간대에 업로드된다면, 강력한 팬덤을 지닌 채널들의 영상에 밀려 시청자의 피드에 제대로 노출조차 되지 못한 채 묻혀버릴 확률이 매우 높습니다.  
					진짜 황금시간대는 남들이 정해주는 것이 아니라, 내 채널의 카테고리와 타겟 시청자의 나이대에 맞춰 전략적으로 계산되어야 합니다.  
				</p>

				<h2>연령대와 카테고리를 교차 분석한 최적의 업로드 전략</h2>
				<p>
					가장 정확한 업로드 시간을 찾기 위해서는 시청자의 하루 일과를 머릿속으로 완벽하게 그려내야 합니다.  
					예를 들어, 10대 학생을 타겟으로 하는 게임이나 유머 콘텐츠라면 그들이 하교하고 학원에 가기 전인 오후 5시가 첫 번째 골든타임이 됩니다.  
					반면, 2030 직장인이 주로 소비하는 경제, 시사, 자기계발 콘텐츠는 그들이 출퇴근 지하철에서 휴대폰을 켜는 오전 7시 반이나 오후 6시 반을 정확히 공략해야 합니다.  
					또한, 4050 주부층이 선호하는 요리 레시피나 살림 꿀팁은 오히려 모두가 출근한 뒤 집안일이 끝나는 오전 10시~11시 사이에 가장 안정적인 클릭률(CTR)과 시청 지속 시간을 보여줍니다.  
					이처럼 타겟의 연령대와 콘텐츠의 성격을 교차 분석하면, 경쟁은 피하면서도 내 영상을 가장 열성적으로 소비해 줄 시청자가 모이는 틈새 시간을 정확히 타격할 수 있습니다.  
				</p>

				<h2>예약 업로드로 일관성을 유지하고 초기 반응을 폭발시키는 방법</h2>
				<p>
					나만의 황금시간대를 찾아냈다면, 이제 남은 것은 시청자에게 예측 가능한 업로드 패턴을 심어주는 것입니다.  
					유튜브 스튜디오의 예약 업로드 기능을 활용하여 매주 정해진 요일과 정확한 시간에 영상을 발행하십시오.  
					시청자가 당신의 영상을 무의식적으로 기다리게 만드는 순간, 업로드 직후의 초기 조회율(View-through Rate)은 수직 상승하며 알고리즘은 이를 <span style="color: #2563eb;">폭발적인 바이럴 콘텐츠</span>로 인식하게 됩니다.  
					아직 내 채널의 타겟을 명확히 모르시겠다면, 상단의 계산기를 통해 카테고리별 거시적 추천 데이터를 먼저 확인해 보십시오.  
					그리고 더 정밀한 나만의 접속 히트맵이 필요하다면 Lumen Insights 솔루션을 통해 시청자들의 24시간 활동 패턴을 직접 눈으로 확인하고 완벽한 골든타임을 쟁취하시길 바랍니다.  
				</p>
			</div>
		</main>
		<Footer />

		<script>
			function calculateTime() {
				const age = (document.getElementById('target-age') as HTMLSelectElement).value;
				const category = (document.getElementById('category') as HTMLSelectElement).value;
				
				const box = document.getElementById('result-box');
				const timeEl = document.getElementById('result-time');
				const descEl = document.getElementById('result-desc');

				if (box && timeEl && descEl) {
					box.style.display = 'block';
					
					let timeStr = "";
					let descStr = "";

					// Logical mapping based on age and category
					if (age === '1020') {
						if (['gaming', 'entertainment', 'music'].includes(category)) {
							timeStr = "평일 오후 5시 ~ 8시 / 주말 오후 1시 ~ 4시";
							descStr = "학생들이 하교하거나 학원에 가기 전 휴식하는 시간대, 그리고 주말 여가 시간에 밈(Meme)과 예능, 게임 콘텐츠 소비가 극대화됩니다.";
						} else if (['education', 'news'].includes(category)) {
							timeStr = "평일 밤 10시 ~ 12시";
							descStr = "학업 일정을 마치고 잠들기 전 누워서 지식이나 시사 정보를 탐색하는 늦은 밤 시간대를 공략해 보세요.";
						} else {
							timeStr = "평일 오후 7시 ~ 10시 / 주말 전일";
							descStr = "전반적으로 여유로운 저녁 시간대나 주말에 가볍게 소비하기 좋은 일상 및 취미 콘텐츠가 유리합니다.";
						}
					} else if (age === '2030') {
						if (['education', 'news', 'autos'].includes(category)) {
							timeStr = "평일 오전 7시 ~ 9시 / 오후 6시 ~ 8시";
							descStr = "직장인들의 출퇴근 대중교통 이동 시간을 노려야 합니다. 경제, 뉴스, 자기계발 등 무거운 주제도 이때 가장 잘 소비됩니다.";
						} else if (['howto', 'travel', 'sports'].includes(category)) {
							timeStr = "평일 오후 8시 ~ 10시 / 주말 오후";
							descStr = "퇴근 후 자기관리나 취미 활동을 준비하며 시청하기 좋은 타이밍입니다.";
						} else {
							timeStr = "평일 오후 9시 ~ 11시 / 주말 저녁";
							descStr = "저녁을 먹으며 스트레스를 풀 수 있는 유머, 예능, 반려동물 콘텐츠가 강세를 보이는 시간대입니다.";
						}
					} else if (age === '4050') {
						if (['howto', 'people', 'pets'].includes(category)) {
							timeStr = "평일 오전 9시 ~ 11시 / 주말 오전";
							descStr = "출근/등교를 마친 후의 여유로운 오전 시간대에 일상, 리빙, 요리 꿀팁 콘텐츠의 시청 지속 시간이 매우 높습니다.";
						} else if (['news', 'education', 'sports'].includes(category)) {
							timeStr = "평일 오후 8시 ~ 10시";
							descStr = "저녁 식사 이후 휴식 시간대에 정보성 콘텐츠나 건강, 시사/뉴스 등의 시청 트래픽이 크게 집중됩니다.";
						} else {
							timeStr = "평일 오후 7시 ~ 9시";
							descStr = "저녁 메인 시간대에 전반적인 미디어 소비가 활발하므로 이 시간대를 추천합니다.";
						}
					}

					timeEl.textContent = timeStr;
					descEl.textContent = descStr;
				}
			}

			// Add event listener (Astro script modules scope fix)
			const calcBtn = document.getElementById('calc-btn');
			if (calcBtn) {
				calcBtn.addEventListener('click', calculateTime);
			}
		</script>
	</body>
</html>
