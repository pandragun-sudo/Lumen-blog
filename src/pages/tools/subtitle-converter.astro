---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`자막 파일 형식 변환기 | ${SITE_TITLE}`} description="SMI, SRT, VTT 자막 파일을 서버 전송 없이 브라우저에서 안전하고 빠르게 상호 변환하세요." />
		<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
		<style>
			main {
				width: 800px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
			}
			h1 {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.tool-container {
				background: var(--bg);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 2.5rem;
				box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
				margin-bottom: 3rem;
			}
			.drop-zone {
				border: 2px dashed var(--border-color);
				border-radius: 12px;
				padding: 4rem 2rem;
				text-align: center;
				cursor: pointer;
				transition: all 0.3s ease;
				background: var(--bg-alt);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				gap: 15px;
			}
			.drop-zone:hover, .drop-zone.dragover {
				border-color: #3b82f6;
				background: rgba(59, 130, 246, 0.05);
			}
			.drop-zone svg {
				color: #3b82f6;
			}
			.drop-zone p {
				margin: 0;
				font-size: 1.1rem;
				color: var(--text-main);
				font-weight: 600;
			}
			.drop-zone span {
				font-size: 0.85rem;
				color: var(--text-muted);
			}
			.controls-section {
				margin-top: 2rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
				background: var(--bg-alt);
				padding: 1.2rem 1.5rem;
				border-radius: 12px;
				border: 1px solid var(--border-color);
				flex-wrap: wrap;
				gap: 1rem;
			}
			.format-select {
				display: flex;
				align-items: center;
				gap: 10px;
			}
			.format-select label {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--text-main);
			}
			select {
				background: var(--bg);
				border: 1px solid var(--border-color);
				color: var(--text-main);
				padding: 0.5rem 1rem;
				border-radius: 6px;
				outline: none;
				font-size: 0.95rem;
				cursor: pointer;
			}
			select:focus {
				border-color: #3b82f6;
			}
			.btn-convert {
				background: #3b82f6;
				color: #ffffff;
				border: none;
				padding: 0.6rem 1.5rem;
				border-radius: 6px;
				font-size: 0.95rem;
				font-weight: 600;
				cursor: pointer;
				transition: background 0.2s;
				display: flex;
				align-items: center;
				gap: 8px;
			}
			.btn-convert:hover {
				background: #2563eb;
			}
			.btn-convert:disabled {
				background: #93c5fd;
				cursor: not-allowed;
			}
			.file-list {
				margin-top: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 10px;
			}
			.file-item {
				background: var(--bg-alt);
				border: 1px solid var(--border-color);
				padding: 1rem;
				border-radius: 8px;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}
			.file-info {
				display: flex;
				align-items: center;
				gap: 12px;
			}
			.file-info svg {
				color: var(--text-muted);
			}
			.file-name {
				font-size: 0.95rem;
				color: var(--text-main);
				font-weight: 500;
			}
			.file-size {
				font-size: 0.8rem;
				color: var(--text-muted);
			}
			.btn-remove {
				background: none;
				border: none;
				color: #ef4444;
				cursor: pointer;
				padding: 4px;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 4px;
			}
			.btn-remove:hover {
				background: rgba(239, 68, 68, 0.1);
			}
			.success-message {
				margin-top: 1.5rem;
				padding: 1rem;
				background: rgba(16, 185, 129, 0.1);
				border: 1px solid rgba(16, 185, 129, 0.2);
				border-radius: 8px;
				color: #10b981;
				display: flex;
				align-items: center;
				gap: 10px;
				font-size: 0.95rem;
				display: none;
			}
			.seo-content {
				line-height: 1.8;
				color: var(--text-main);
			}
			.seo-content h2 {
				margin-top: 2.5rem;
				margin-bottom: 1rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #ec4899;"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><path d="m9 15 2 2 4-4"/></svg> 자막 파일 형식 변환기</h1>
			<p style="color: var(--text-muted); margin-bottom: 2rem;">
				SMI, SRT, VTT 형식의 자막 파일을 서로 자유롭게 변환하세요. 별도의 프로그램 설치나 서버 전송 없이 브라우저 내에서 안전하게 즉시 변환됩니다.
			</p>
			
			<div class="tool-container">
				<div class="drop-zone" id="dropZone">
					<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m8 16 4-4 4 4"/></svg>
					<p>파일을 여기에 끌어다 놓거나 클릭하여 선택하세요</p>
					<span>지원 형식: .smi, .srt, .vtt (여러 파일 동시 선택 가능)</span>
					<input type="file" id="fileInput" accept=".smi,.srt,.vtt" style="display: none;" multiple autocomplete="off" spellcheck="false">
				</div>

				<div class="file-list" id="fileList">
					<!-- File items will be injected here -->
				</div>

				<div class="controls-section">
					<div class="format-select">
						<label for="targetFormat">변환할 포맷:</label>
						<select id="targetFormat" autocomplete="off">
							<option value="srt">SRT (표준 자막)</option>
							<option value="vtt">VTT (웹 표준 자막)</option>
							<option value="smi">SMI (기존 포맷)</option>
						</select>
					</div>
					<button class="btn-convert" id="convertBtn" disabled>
						<svg id="convertIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
						변환 및 다운로드
					</button>
				</div>

				<div class="success-message" id="successMessage">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg> 
					변환이 성공적으로 완료되어 다운로드가 시작되었습니다.
				</div>
			</div>

			<div class="seo-content">
				<h2>유튜브 및 동영상 플랫폼에서 자막 파일의 중요성</h2>
				<p>
					글로벌 시청자를 타겟으로 하는 동영상 플랫폼 환경에서 다국어 자막 제공은 더 이상 선택이 아닌 필수입니다. 유튜브 쇼츠(Shorts)나 롱폼 영상에 적절한 자막을 추가하면, 언어 장벽을 허물어 트래픽을 극대화할 수 있습니다. 시청자는 소리를 켤 수 없는 대중교통이나 공공장소에서도 자막을 통해 영상 내용을 완벽하게 이해할 수 있습니다. 통계에 따르면 전체 동영상 시청의 상당 부분이 음소거 상태로 이루어지며, 자막이 제공된 영상은 그렇지 않은 영상에 비해 시청 유지 시간(Retention)과 클릭률(CTR)이 압도적으로 높게 나타납니다. 알고리즘 역시 자막 파일에 포함된 텍스트 데이터를 분석하여 검색 엔진 최적화(SEO) 및 적절한 시청자 타겟팅에 활용합니다. 따라서 올바른 포맷의 자막 파일을 생성하고 업로드하는 것은 성공적인 채널 운영의 핵심 전략입니다.
				</p>

				<h2>SMI, SRT, VTT 포맷의 차이점과 변환의 필요성</h2>
				<p>
					동영상 편집과 재생 환경에 따라 요구되는 자막 파일의 포맷은 각기 다릅니다. 국내에서 과거부터 가장 널리 사용된 SMI(SAMI) 포맷은 HTML 태그를 기반으로 하여 글꼴, 색상, 위치 등 다양한 시각적 효과를 구현할 수 있습니다. 그러나 유튜브를 비롯한 글로벌 플랫폼과 최신 스마트TV 환경에서는 SMI 포맷을 완벽하게 지원하지 않는 경우가 많습니다. 반면 SRT(SubRip Text)는 가장 널리 통용되는 글로벌 표준 자막 포맷입니다. 구조가 매우 단순하고 직관적이며 거의 모든 동영상 플레이어와 편집 프로그램(프리미어 프로, 파이널 컷 등)에서 완벽하게 호환됩니다. VTT(WebVTT)는 HTML5 웹 표준을 기반으로 설계된 차세대 자막 포맷입니다. 텍스트 포맷팅을 지원하면서도 웹 환경에서의 처리 속도가 뛰어나 점차 그 사용 비중이 높아지고 있습니다. 이처럼 플랫폼마다 선호하는 자막 형식이 다르기 때문에, 제작한 자막을 자유롭게 상호 변환할 수 있는 도구의 필요성이 대두됩니다.
				</p>

				<h2>무설치 100% 프론트엔드 자막 변환기의 장점</h2>
				<p>
					인터넷에 존재하는 대다수의 무료 자막 변환 서비스는 사용자가 업로드한 파일을 서버로 전송하여 변환한 뒤 다시 다운로드하게 하는 방식을 취합니다. 이 과정에서 미출시 영상의 스크립트나 중요한 번역 데이터가 외부 서버에 기록되거나 유출될 수 있는 보안 취약점이 존재합니다. 본 Lumen Insights 자막 파일 형식 변환기는 사용자의 기기(브라우저) 내부에서만 자바스크립트를 이용해 변환 연산을 수행하는 100% 프론트엔드 기반으로 동작합니다. 파일이 외부 서버로 단 한 번도 전송되지 않으므로 개인정보와 원본 데이터가 완벽하게 보호됩니다. 또한 서버와의 통신 과정이 생략되기 때문에 네트워크 환경에 구애받지 않고 대용량 자막 파일이나 수십 개의 파일을 눈 깜짝할 사이에 즉시 변환할 수 있습니다.
				</p>
				
				<h2>효율적인 다중 파일 변환 및 압축(ZIP) 지원</h2>
				<p>
					장편 드라마나 시리즈물, 혹은 다국어 번역을 위해 여러 개의 자막 파일을 동시에 다루어야 하는 전문가들을 위해 다중 파일 변환 기능을 지원합니다. 여러 개의 SMI 혹은 SRT 파일을 드래그 앤 드롭으로 한 번에 선택하여 일괄 변환할 수 있으며, 두 개 이상의 파일을 변환할 경우 결과물은 단일 ZIP 압축 파일로 묶여 다운로드됩니다. 이를 통해 파일 관리의 번거로움을 줄이고 작업 시간을 비약적으로 단축할 수 있습니다. 운영체제(Windows, macOS)에 관계없이 브라우저만 있다면 언제 어디서나 즉시 사용할 수 있으며, 모바일 환경에서도 동일한 보안과 성능을 보장합니다. 철저한 데이터 기반으로 채널을 운영하는 크리에이터들에게 이 변환기는 콘텐츠의 글로벌 진출을 돕는 강력한 무기가 될 것입니다.
				</p>

				<h2>오류 없는 완벽한 자막 변환을 위한 팁</h2>
				<p>
					자막 파일을 변환할 때 가장 빈번하게 발생하는 문제는 '싱크(Sync)' 오류와 텍스트 인코딩(깨짐) 현상입니다. 기존의 오래된 SMI 파일들은 ANSI 인코딩으로 저장된 경우가 많아, 최신 환경에서 변환 시 한글이 외계어로 깨져 보이는 경우가 발생합니다. 이 변환기는 브라우저의 기본 인코딩 처리 엔진을 활용하여 높은 확률로 텍스트를 안전하게 읽어들입니다. 만약 변환 후 글자가 깨진다면 원본 파일을 메모장에서 열어 'UTF-8' 형식으로 다시 저장한 뒤 변환하는 것을 권장합니다. 또한, 원본 파일 내부에 비정상적인 태그나 줄바꿈이 포함된 경우 변환 알고리즘이 이를 자동으로 교정하여 깔끔한 SRT나 VTT로 출력합니다. 변환된 자막은 유튜브 스튜디오에서 '자막 추가' 기능을 통해 업로드할 수 있으며, 영상의 노출 수와 시청자 리텐션 데이터를 향상시키는 핵심 동력이 됩니다.
				</p>
			</div>
		</main>
		<Footer />

		<script>
			// Wrap in an IIFE or use standard DOMContentLoaded since Astro injects scripts
			document.addEventListener('DOMContentLoaded', () => {
				const dropZone = document.getElementById('dropZone');
				const fileInput = document.getElementById('fileInput');
				const fileList = document.getElementById('fileList');
				const convertBtn = document.getElementById('convertBtn') as HTMLButtonElement;
				const targetFormatSelect = document.getElementById('targetFormat') as HTMLSelectElement;
				const successMessage = document.getElementById('successMessage');

				let selectedFiles: File[] = [];

				if(!dropZone || !fileInput || !convertBtn || !fileList || !targetFormatSelect) return;

				// Drag & Drop Events
				dropZone.addEventListener('dragover', (e) => {
					e.preventDefault();
					dropZone.classList.add('dragover');
				});

				dropZone.addEventListener('dragleave', () => {
					dropZone.classList.remove('dragover');
				});

				dropZone.addEventListener('drop', (e) => {
					e.preventDefault();
					dropZone.classList.remove('dragover');
					if (e.dataTransfer && e.dataTransfer.files.length > 0) {
						handleFiles(e.dataTransfer.files);
					}
				});

				dropZone.addEventListener('click', () => {
					fileInput.click();
				});

				fileInput.addEventListener('change', (e) => {
					const target = e.target as HTMLInputElement;
					if (target.files && target.files.length > 0) {
						handleFiles(target.files);
					}
					target.value = '';
				});

				function handleFiles(files: FileList) {
					if(successMessage) successMessage.style.display = 'none';
					
					for (let i = 0; i < files.length; i++) {
						const file = files[i];
						const ext = file.name.split('.').pop()?.toLowerCase() || '';
						if (['smi', 'srt', 'vtt'].includes(ext)) {
							// Check for duplicates
							if (!selectedFiles.find(f => f.name === file.name && f.size === file.size)) {
								selectedFiles.push(file);
							}
						} else {
							alert(`지원하지 않는 파일 형식입니다: ${file.name}`);
						}
					}
					renderFileList();
				}

				function removeFile(index: number) {
					selectedFiles.splice(index, 1);
					renderFileList();
				}

				// Make removeFile globally accessible for inline onclick
				(window as any).removeFile = removeFile;

				function renderFileList() {
					if(!fileList) return;
					fileList.innerHTML = '';
					
					if (selectedFiles.length === 0) {
						convertBtn.disabled = true;
						return;
					}

					convertBtn.disabled = false;
					
					selectedFiles.forEach((file, index) => {
						const ext = file.name.split('.').pop()?.toUpperCase() || '';
						const size = (file.size / 1024).toFixed(1) + ' KB';
						
						const div = document.createElement('div');
						div.className = 'file-item';
						div.innerHTML = `
							<div class="file-info">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
								<div>
									<div class="file-name">${file.name}</div>
									<div class="file-size">${ext} • ${size}</div>
								</div>
							</div>
							<button class="btn-remove" onclick="removeFile(${index})" title="제거">
								<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
							</button>
						`;
						fileList.appendChild(div);
					});
				}

				convertBtn.addEventListener('click', async () => {
					if (selectedFiles.length === 0) return;
					
					const targetExt = targetFormatSelect.value;
					
					convertBtn.disabled = true;
					
					try {
						const useZip = selectedFiles.length > 1;
						// @ts-ignore
						const zip = useZip ? new JSZip() : null;

						for (let file of selectedFiles) {
							const text = await file.text();
							const sourceExt = file.name.split('.').pop()?.toLowerCase() || '';
							let resultText = '';
							
							if (sourceExt === targetExt) {
								resultText = text; 
							} 
							else if (sourceExt === 'smi' && targetExt === 'srt') {
								resultText = convertSmiToSrt(text);
							}
							else if (sourceExt === 'smi' && targetExt === 'vtt') {
								resultText = convertSrtToVtt(convertSmiToSrt(text));
							}
							else if (sourceExt === 'srt' && targetExt === 'smi') {
								resultText = convertSrtToSmi(text);
							}
							else if (sourceExt === 'srt' && targetExt === 'vtt') {
								resultText = convertSrtToVtt(text);
							}
							else if (sourceExt === 'vtt' && targetExt === 'srt') {
								resultText = convertVttToSrt(text);
							}
							else if (sourceExt === 'vtt' && targetExt === 'smi') {
								resultText = convertSrtToSmi(convertVttToSrt(text));
							}
							else {
								resultText = text; 
							}

							const newFileName = file.name.replace(/\.[^/.]+$/, "") + `_converted.${targetExt}`;
							
							if (useZip && zip) {
								zip.file(newFileName, resultText);
							} else {
								downloadFile(resultText, newFileName);
							}
						}

						if (useZip && zip) {
							const content = await zip.generateAsync({ type: 'blob' });
							const url = URL.createObjectURL(content);
							const a = document.createElement('a');
							a.href = url;
							a.download = `lumen_subtitles_${Date.now()}.zip`;
							document.body.appendChild(a);
							a.click();
							document.body.removeChild(a);
							URL.revokeObjectURL(url);
						}
						
						if(successMessage) successMessage.style.display = 'flex';
						selectedFiles = [];
						renderFileList();
						
					} catch (error) {
						console.error(error);
						alert("변환 중 오류가 발생했습니다.");
					} finally {
						convertBtn.disabled = false;
					}
				});

				function downloadFile(content: string, fileName: string) {
					const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
					const url = URL.createObjectURL(blob);
					const a = document.createElement('a');
					a.href = url;
					a.download = fileName;
					document.body.appendChild(a);
					a.click();
					document.body.removeChild(a);
					URL.revokeObjectURL(url);
				}

				// --- CORE CONVERSION FUNCTIONS ---

				function formatTime(ms: number) {
					let date = new Date(ms);
					let h = String(date.getUTCHours()).padStart(2, '0');
					let m = String(date.getUTCMinutes()).padStart(2, '0');
					let s = String(date.getUTCSeconds()).padStart(2, '0');
					let milli = String(ms % 1000).padStart(3, '0');
					return `${h}:${m}:${s},${milli}`;
				}

				function convertSmiToSrt(smiText: string) {
					let srt = "";
					let index = 1;
					const bodyMatch = smiText.match(/<BODY>([\s\S]*?)<\/BODY>/i);
					let body = bodyMatch ? bodyMatch[1] : smiText;
					
					const syncs = body.split(/<SYNC Start=/i);
					let parsedSyncs = [];
					
					for (let i = 1; i < syncs.length; i++) {
						let sync = syncs[i];
						let timeMatch = sync.match(/^(\d+)(.*)/s);
						if (timeMatch) {
							let time = parseInt(timeMatch[1], 10);
							let content = timeMatch[2].replace(/<P[^>]*>/gi, '').trim();
							content = content.replace(/<br\s*\/?>/gi, '\n');
							content = content.replace(/&nbsp;/gi, '').trim();
							parsedSyncs.push({ time, content });
						}
					}
					
					for (let i = 0; i < parsedSyncs.length - 1; i++) {
						let current = parsedSyncs[i];
						let next = parsedSyncs[i + 1];
						
						if (current.content && current.content !== '') {
							srt += `${index}\n`;
							srt += `${formatTime(current.time)} --> ${formatTime(next.time)}\n`;
							srt += `${current.content}\n\n`;
							index++;
						}
					}
					return srt.trim();
				}

				function convertSrtToSmi(srtText: string) {
					let smi = "<SAMI>\n<HEAD>\n<TITLE>Lumen Converted</TITLE>\n</HEAD>\n<BODY>\n";
					const blocks = srtText.replace(/\r\n/g, '\n').split('\n\n');
					
					for (let block of blocks) {
						if (!block.trim()) continue;
						let lines = block.split('\n');
						if (lines.length >= 3) {
							let timeLine = lines[1];
							let timeMatch = timeLine.match(/(\d{2}):(\d{2}):(\d{2}),(\d{3})\s*-->\s*(\d{2}):(\d{2}):(\d{2}),(\d{3})/);
							if (timeMatch) {
								let startMs = parseInt(timeMatch[1])*3600000 + parseInt(timeMatch[2])*60000 + parseInt(timeMatch[3])*1000 + parseInt(timeMatch[4]);
								let endMs = parseInt(timeMatch[5])*3600000 + parseInt(timeMatch[6])*60000 + parseInt(timeMatch[7])*1000 + parseInt(timeMatch[8]);
								
								let text = lines.slice(2).join('<br>');
								smi += `<SYNC Start=${startMs}><P Class=KRCC>${text}\n`;
								smi += `<SYNC Start=${endMs}><P Class=KRCC>&nbsp;\n`;
							}
						}
					}
					smi += "</BODY>\n</SAMI>";
					return smi;
				}

				function convertSrtToVtt(srtText: string) {
					let vtt = "WEBVTT\n\n";
					let blocks = srtText.replace(/\r\n/g, '\n').split('\n\n');
					for (let block of blocks) {
						if (!block.trim()) continue;
						let lines = block.split('\n');
						if (lines.length >= 3) {
							let timeLine = lines[1].replace(/,/g, '.');
							let text = lines.slice(2).join('\n');
							vtt += `${timeLine}\n${text}\n\n`;
						}
					}
					return vtt.trim();
				}

				function convertVttToSrt(vttText: string) {
					let srt = "";
					let index = 1;
					let blocks = vttText.replace(/\r\n/g, '\n').split('\n\n');
					for (let block of blocks) {
						if (block.trim() === "WEBVTT" || block.startsWith("WEBVTT\n") || !block.trim()) continue;
						let lines = block.split('\n');
						let timeLineIndex = lines.findIndex(l => l.includes('-->'));
						if (timeLineIndex !== -1) {
							let timeLine = lines[timeLineIndex].replace(/\./g, ',');
							let text = lines.slice(timeLineIndex + 1).join('\n');
							srt += `${index}\n${timeLine}\n${text}\n\n`;
							index++;
						}
					}
					return srt.trim();
				}
			});
		</script>
	</body>
</html>
