---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="nav-right">
			<div class="internal-links">
				<HeaderLink href="/">Home</HeaderLink>
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/tools">Tools</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</div>
			<a href="https://app.lumeninsights.kr/?utm_source=lumen_blog&utm_medium=referral&utm_campaign=blog_header" class="header-premium-btn" target="_blank" rel="noopener noreferrer">
				<span class="rocket"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 3.86-11.23c.31-.47.9-.59 1.4-.29.49.29.62.9.29 1.4A20 20 0 0 0 12 15z"/><path d="M12 15c-1.12-2.82-3.1-5-5.5-6a2 2 0 0 0-2.73.91 2 2 0 0 0 .91 2.73C7 15 9.18 17 12 15z"/><path d="m15 12 3 3c2.82-1.12 5-3.1 6-5.5a2 2 0 0 0-.91-2.73 2 2 0 0 0-2.73.91A20 20 0 0 0 15 12z"/><path d="M15 12c-2.82-1.12-5-3.1-6-5.5a2 2 0 0 0-2.73.91 2 2 0 0 0 .91 2.73 22 22 0 0 1 11.23 3.86c.47.31.59.9.29 1.4-.29.49-.9.62-1.4.29A20 20 0 0 0 15 12z"/><path d="M15 9h.01"/></svg></span> 앱 시작하기
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg);
		border-bottom: 1px solid var(--border-color);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
		font-weight: 700;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--text-main);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		height: 70px;
	}
	.internal-links {
		display: flex;
		gap: 2em;
	}
	.internal-links a {
		padding: 1em 0;
		color: var(--text-muted);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95em;
		transition: color 0.2s ease;
	}
	.internal-links a:hover {
		color: var(--text-main);
	}
	.internal-links a.active {
		color: var(--text-main);
		border-bottom-color: var(--text-main);
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 2em;
	}
	.header-premium-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: #111827;
		color: #ffffff !important;
		padding: 8px 16px;
		border-radius: 8px;
		font-weight: 700;
		font-size: 0.85em;
		text-decoration: none !important;
		border: 1px solid #374151;
		transition: all 0.2s ease;
		box-shadow: 0 2px 8px rgba(17, 24, 39, 0.2);
	}
	.header-premium-btn:hover {
		background: #1f2937;
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(17, 24, 39, 0.3);
	}
	.rocket {
		font-size: 1.1em;
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			height: auto;
			padding: 1em 0;
			gap: 1em;
		}
		.nav-right {
			flex-direction: column;
			gap: 1em;
		}
		.internal-links {
			gap: 1.5em;
		}
	}
</style>
