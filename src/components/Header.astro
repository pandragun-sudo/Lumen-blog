---
import { SITE_BRAND } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/" class="brand-link">
				<img src="/favicon.png" alt="Lumen Insights Lab" width="26" height="26" class="brand-icon" />
				<span>{SITE_BRAND}</span>
			</a>
		</h2>
		<div class="nav-right">
			<div class="internal-links">
				<HeaderLink href="/">홈</HeaderLink>
				<HeaderLink href="/blog">블로그</HeaderLink>
				<HeaderLink href="/about">소개</HeaderLink>
				<HeaderLink href="/contact">문의하기</HeaderLink>
			</div>
			<a href="https://youtube.com/@lumeninsightslab" target="_blank" rel="noopener noreferrer" class="header-youtube-btn" title="공식 유튜브 채널">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
					<path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
				</svg>
				<span>유튜브</span>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg);
		border-bottom: 1px solid var(--border-color);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
		font-weight: 700;
	}
	.brand-link {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
		color: var(--text-main);
	}
	.brand-icon {
		border-radius: 6px;
		box-shadow: 0 2px 8px rgba(147, 51, 234, 0.25);
		display: block;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
		height: 70px;
	}
	.internal-links {
		display: flex;
		gap: 2em;
	}
	.internal-links a {
		padding: 1em 0;
		color: var(--text-muted);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95em;
		transition: color 0.2s ease;
	}
	.internal-links a:hover {
		color: var(--text-main);
	}
	.internal-links a.active {
		color: var(--text-main);
		border-bottom-color: var(--text-main);
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 2em;
	}
	.header-youtube-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		background: #dc2626;
		color: #ffffff !important;
		padding: 6px 14px;
		border-radius: 8px;
		font-weight: 700;
		font-size: 0.85em;
		text-decoration: none !important;
		transition: all 0.2s ease;
		box-shadow: 0 2px 8px rgba(220, 38, 38, 0.25);
	}
	.header-youtube-btn:hover {
		background: #b91c1c;
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35);
	}
	@media (max-width: 720px) {
		nav {
			flex-direction: column;
			height: auto;
			padding: 1em 0;
			gap: 1em;
		}
		.nav-right {
			flex-direction: column;
			gap: 1em;
		}
		.internal-links {
			gap: 1.5em;
		}
	}
</style>
